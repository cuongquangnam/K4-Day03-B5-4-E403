# =============================================================================
# ⚙️ CẤU HÌNH MULTI-PROVIDER LLM ADAPTER
# =============================================================================

# -----------------------------------------------------------------------------
# 📌 BƯỚC 1: CHỌN NHÀ CUNG CẤP AI (LLM_PROVIDER)
# Chọn 1 trong các giá trị sau: gemini | openai | anthropic | openrouter | mock
# -----------------------------------------------------------------------------
LLM_PROVIDER=gemini

# -----------------------------------------------------------------------------
# 📌 BƯỚC 2: ĐIỀN API KEY CHO PROVIDER ĐÃ CHỌN Ở BƯỚC 1
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# -----------------------------------------------------------------------------
# 📌 BƯỚC 3: (TÙY CHỌN) GHI ĐÈ TÊN MODEL CỤ THỂ (LLM_MODEL)
# 
# 💡 Mặc định nếu ĐỂ TRỐNG (LLM_MODEL=), hệ thống tự dùng Model chuẩn của Provider:
#   - Nếu chọn LLM_PROVIDER=gemini     ➔ Mặc định dùng: gemini-2.0-flash
#   - Nếu chọn LLM_PROVIDER=openai     ➔ Mặc định dùng: gpt-4o-mini
#   - Nếu chọn LLM_PROVIDER=anthropic  ➔ Mặc định dùng: claude-3-haiku-20240307
#   - Nếu chọn LLM_PROVIDER=openrouter ➔ Mặc định dùng: google/gemini-2.5-flash
#
# ✏️ Ví dụ nếu muốn ĐỔI MODEL KHÁC (Điền tên Model cụ thể vào sau dấu =):
# LLM_MODEL=gpt-4o
# LLM_MODEL=claude-3-5-sonnet-20240620
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# -----------------------------------------------------------------------------
LLM_MODEL=

# -----------------------------------------------------------------------------
# 🏠 TOOL ENV - SEARCH HOME INFO (Facebook + Batdongsan)
# -----------------------------------------------------------------------------
# 1) Facebook Graph API (feed của group/page)
FACEBOOK_ACCESS_TOKEN=your_facebook_graph_api_access_token
FACEBOOK_GROUP_OR_PAGE_ID=your_facebook_group_or_page_id
FACEBOOK_GRAPH_API_VERSION=v19.0
FACEBOOK_MAX_RESULTS=10

# 2) Batdongsan.com.vn
# Cách khuyến nghị: bạn có 1 scraper service (API của team) bọc việc crawl batdongsan
# và trả về JSON list listing: [{title, price_vnd, phone, profile, contact_name}, ...]
BDS_SCRAPE_API_URL=your_batdongsan_scraper_service_url

# Cách fallback (best-effort): scrape trực tiếp HTML từ URL bạn chỉ định.
# Nếu dùng cách này thì cần set BDS_SEARCH_URL hoặc BDS_SEARCH_URL_TEMPLATE.
BDS_SEARCH_URL=
# Ví dụ template (tùy bạn chỉnh đúng pattern của batdongsan):
# Với Quận đánh số (ví dụ Quận 7):
# Base: https://batdongsan.com.vn/cho-thue-can-ho-chung-cu-quan-7
# Lọc phòng ngủ: /1pn hoặc /2pn hoặc /3pn
# BDS_SEARCH_URL_TEMPLATE có thể tự xây theo pattern bạn dùng:
# BDS_SEARCH_URL_TEMPLATE=https://batdongsan.com.vn/cho-thue-can-ho-chung-cu-quan-7/1pn
BDS_SEARCH_URL_TEMPLATE=

# Batdongsan có thể chặn bot (Cloudflare). Mặc định tắt direct scrape.
# Chỉ bật khi bạn có proxy/cookie hợp lệ hoặc scraper service không dùng được.
BDS_DIRECT_SCRAPE=0

# -----------------------------------------------------------------------------
# 📅 TOOL ENV - CALENDAR
# -----------------------------------------------------------------------------
CALENDAR_PROVIDER=google_calendar
CALENDAR_USER_ID=user_001
CALENDAR_TIMEZONE=Asia/Ho_Chi_Minh
# Endpoint API (production) để lấy slot rảnh
# Response được kỳ vọng: {"slots":[{"start":"...","end":"..."}]} hoặc trực tiếp list slot.
CALENDAR_API_URL=
CALENDAR_SLOTS_JSON=[{"start":"2026-07-30T19:00:00+07:00","end":"2026-07-30T20:30:00+07:00"}]

# -----------------------------------------------------------------------------
# 💬 TOOL ENV - ZALO
# -----------------------------------------------------------------------------
ZALO_OA_ID=your_zalo_oa_id
ZALO_ACCESS_TOKEN=your_zalo_access_token
# Endpoint API (production) để gửi tin nhắn qua Zalo
# Response kỳ vọng: JSON bất kỳ (tool chỉ cần status_code==200)
ZALO_SEND_API_URL=
ZALO_MODE=sandbox
